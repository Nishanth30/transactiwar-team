MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=app_database
MYSQL_USER=app_user
MYSQL_PASSWORD=change-this-app-password
APP_BIND=0.0.0.0
CSRF_ALLOWED_ORIGIN=https://localhost
APP_DIAGNOSTIC_MODE=0
DB_WAIT_ATTEMPTS=60
DB_WAIT_SLEEP_SECONDS=2
SESSION_SECRET=replace-with-at-least-32-random-characters
TRUSTED_PROXIES=
ENFORCE_HTTPS=1
GENERATE_SELF_SIGNED_TLS=1
TLS_CERT_CN=localhost
TLS_CERT_SAN=DNS:localhost,IP:127.0.0.1,IP:::1
TLS_SELF_SIGNED_DAYS=30
DISCORD_WEBHOOK_URL=
