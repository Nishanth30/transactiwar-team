# ── Static Assets Only ────────────────────────────────────────────────────────
# Only CSS, JS, images, fonts, etc. should ever be served from here.
# Block any attempt to place and execute PHP or scripts in this directory.

# No PHP execution
<FilesMatch "\.(php|php[0-9]|phtml|phar|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>

Options -Indexes -ExecCGI
