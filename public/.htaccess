# ── Security Headers ──────────────────────────────────────────────────────────
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-XSS-Protection "1; mode=block"
# M1 FIX: CSP is set dynamically by PHP (includes/header.php) with per-request
# nonces. A static CSP here conflicts: browsers enforce the intersection of
# multiple CSP headers, so the nonce-less policy below would block all
# nonce-authenticated scripts. Removed to let the PHP-generated CSP govern.
# Header always set Content-Security-Policy "..."

# ── Prevent Directory Listing ─────────────────────────────────────────────────
Options -Indexes

# ── Block access to sensitive file extensions ─────────────────────────────────
# Prevents leaking logs, SQL dumps, backups, markdown docs, etc.
<FilesMatch "\.(env|log|ini|sh|sql|md|bak|old|swp|htpasswd)$">
    Require all denied
</FilesMatch>

# ── Block access to hidden files (e.g. .git, .env, .gitignore) ───────────────
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# ── Force HTTPS ───────────────────────────────────────────────────────────────
# Uncomment the lines below if your server has SSL configured
# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
